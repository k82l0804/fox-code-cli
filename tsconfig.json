{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true,
    "noEmit": true,
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid",
    "noUncheckedIndexedAccess": false,
    "customConditions": ["browser"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@tui/*": ["./packages/tui/src/*"],
      "@test/*": ["./test/*"],
      "@opencode-ai/core": ["./packages/core/src/index.ts"],
      "@opencode-ai/core/*": ["./packages/core/src/*"],
      "@opencode-ai/codemode": ["./packages/codemode/src/index.ts"],
      "@opencode-ai/codemode/*": ["./packages/codemode/src/*"],
      "@opencode-ai/llm": ["./packages/llm/src/index.ts"],
      "@opencode-ai/llm/*": ["./packages/llm/src/*"],
      "@opencode-ai/protocol": ["./packages/protocol/src/index.ts"],
      "@opencode-ai/protocol/*": ["./packages/protocol/src/*"],
      "@opencode-ai/schema": ["./packages/schema/src/index.ts"],
      "@opencode-ai/schema/*": ["./packages/schema/src/*"],
      "@opencode-ai/server": ["./packages/server/src/index.ts"],
      "@opencode-ai/server/*": ["./packages/server/src/*"],
      "@opencode-ai/tui": ["./packages/tui/src/index.tsx"],
      "@opencode-ai/tui/*": ["./packages/tui/src/*"],
      "@opencode-ai/ui": ["./packages/ui/src/index.ts"],
      "@opencode-ai/ui/*": ["./packages/ui/src/*"],
      "@opencode-ai/effect-drizzle-sqlite": ["./packages/effect-drizzle-sqlite/src/index.ts"],
      "@opencode-ai/effect-drizzle-sqlite/*": ["./packages/effect-drizzle-sqlite/src/*"],
      "@opencode-ai/effect-sqlite-node": ["./packages/effect-sqlite-node/src/index.ts"],
      "@opencode-ai/effect-sqlite-node/*": ["./packages/effect-sqlite-node/src/*"],
      "@foxcode/plugin": ["./packages/plugin/src/index.ts"],
      "@foxcode/plugin/*": ["./packages/plugin/src/*"],
      "@foxcode/plugin-atomic-chat": ["./packages/plugin-atomic-chat/src/index.ts"],
      "@foxcode/plugin-atomic-chat/*": ["./packages/plugin-atomic-chat/src/*"],
      "@foxcode/sdk": ["./packages/sdk/src/index.ts"],
      "@foxcode/sdk/*": ["./packages/sdk/src/*"],
      "@foxcode/sandbox": ["./packages/sandbox/src/index.ts"],
      "@foxcode/sandbox/*": ["./packages/sandbox/src/*"],
      "@foxcode/memory": ["./packages/fox-memory/src/index.ts"],
      "@foxcode/memory/*": ["./packages/fox-memory/src/*"],
      "@foxcode/indexing": ["./packages/fox-indexing/src/index.ts"],
      "@foxcode/indexing/*": ["./packages/fox-indexing/src/*"]
    }
  },
  "include": [
    "src/**/*",
    "packages/*/src/**/*"
  ]
}
