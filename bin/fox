#!/usr/bin/env bun
import { spawn } from "node:child_process"
import { fileURLToPath } from "node:url"
import { dirname, join } from "node:path"

const __filename = fileURLToPath(import.meta.url)
const __dirname = dirname(__filename)
const entry = join(__dirname, "..", "src", "index.ts")
const preload = fileURLToPath(import.meta.resolve("@opentui/solid/preload"))

const child = spawn(
  "bun",
  ["run", "--preload", preload, "--jsx-import-source=@opentui/solid", entry, ...process.argv.slice(2)],
  {
    stdio: "inherit",
    env: {
      ...process.env,
      FOX_CLIENT: "cli",
      // Sextant glyphs (U+1FB00+) require Unicode 13 font support (e.g. Nerd Fonts).
      // Default to the half-block fallback; set FOX_UNICODE_LOGO=true to opt in.
      FOX_UNICODE_LOGO: process.env.FOX_UNICODE_LOGO ?? "false",
    },
  },
)

child.on("exit", (code) => {
  process.exit(code ?? 0)
})
