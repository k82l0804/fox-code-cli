{
  "$schema": "https://json.schemastore.org/package.json",
  "version": "0.1.0",
  "name": "@fox/cli",
  "description": "Fox Code CLI — offline-first AI coding agent based on ACP",
  "author": "Fox Code Authors",
  "type": "module",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k82l0804/fox.git",
    "directory": "fox-code-cli"
  },
  "homepage": "https://github.com/k82l0804/fox",
  "bugs": "https://github.com/k82l0804/fox/issues",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "bun build --target bun --packages=external --jsx-import-source=@opentui/solid ./src/index.ts --outdir ./dist",
    "dev": "bun run ./src/index.ts",
    "fox": "bun run ./src/index.ts",
    "test": "bash scripts/test-all.sh",
    "test:smoke": "bash scripts/test-smoke.sh",
    "test:patch": "bun test test/patch.test.ts test/transaction.test.ts test/transaction-confidence.test.ts --timeout 30000",
    "test:edit": "bun test test/edit-replacers.test.ts test/encoding.test.ts --timeout 30000",
    "test:config": "bun test test/config-merge.test.ts --timeout 30000",
    "test:tier": "bun test test/model-tier.test.ts test/model-profile.test.ts --timeout 10000",
    "test:autonomous": "bun test test/oscillation.test.ts test/verification.test.ts test/repair-budget.test.ts --timeout 30000",
    "test:compress": "bun test packages/core/test/compress.test.ts packages/core/test/compression-roi.test.ts --timeout 30000",
    "test:standard-suite": "bun test test/standard-suite.test.ts --timeout 30000",
    "test:schema-stability": "bun test packages/core/test/schema-stability.test.ts --timeout 10000",
    "test:app": "bun test ./test/*.test.ts ./test/*/*.test.ts --timeout 30000",
    "scoreboard": "bun run tools/fox-standard-scoreboard.ts",
    "showdown": "bun run tools/fox-vs-kilo-showdown.ts",
    "ab:standard": "bun run tools/fox-standard-ab-eval.ts",
    "test:challenge": "bun test test/challenge-ladder.test.ts --timeout 60000",
    "challenge:scoreboard": "bun run tools/fox-challenge-scoreboard.ts",
    "challenge:snapshot": "bun run tools/challenge-snapshot.ts"
  },
  "bin": {
    "fox": "./bin/fox",
    "fox-code": "./bin/fox"
  },
  "exports": {
    "./*": "./src/*.ts"
  },
  "imports": {
    "#db": {
      "bun": "./src/storage/db.bun.ts",
      "node": "./src/storage/db.node.ts",
      "default": "./src/storage/db.bun.ts"
    },
    "#sqlite": {
      "bun": "./packages/core/src/database/sqlite.bun.ts",
      "node": "./packages/core/src/database/sqlite.node.ts",
      "default": "./packages/core/src/database/sqlite.bun.ts"
    },
    "#pty": {
      "bun": "./packages/core/src/pty/pty.bun.ts",
      "node": "./packages/core/src/pty/pty.node.ts",
      "default": "./packages/core/src/pty/pty.bun.ts"
    },
    "#fff": {
      "bun": "./packages/core/src/filesystem/fff.bun.ts",
      "node": "./packages/core/src/filesystem/fff.node.ts",
      "default": "./packages/core/src/filesystem/fff.bun.ts"
    }
  },
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@effect/platform-node": "4.0.0-beta.83",
      "@npmcli/arborist": "9.4.0",
      "@types/bun": "1.3.14",
